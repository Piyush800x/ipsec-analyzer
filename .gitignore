# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
dist/
build/

# uv
# uv.lock IS committed — it is the reproducibility guarantee.

# Node / Next.js
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# Environment
.env
.env.local
.env.*.local
!.env.example

# Local data — captures and databases never enter the repository
data/
*.db
*.sqlite
*.sqlite3
backend/data/
captures/

# Datasets and model artefacts are DVC-tracked, not git-tracked
dataset/**/*.pcap
dataset/**/*.pcapng
# Generated sessions: a batch run writes a labels.json and a manifest.json
# beside every capture, and 200 of those would otherwise land in a `git add -A`
# even though the captures beside them are ignored. Step 8.4 puts the whole
# tree under DVC.
dataset/sessions/
backend/models/*.pkl
backend/models/*.joblib
backend/models/*.onnx
backend/models/*.pt
# LightGBM writes its boosters as text, which git would happily swallow.
backend/models/*.txt
backend/models/*.meta.json
backend/models/calibration.json

# The batch logs of a generation run. Several megabytes of per-session INFO
# lines whose useful content is already summarised in CHANGELOG.md.
dataset/gen*.log
dataset/pilot*.log
dataset/verify.log
dataset/train.log

# metrics.json, reliability_cnn.json and external_validation.json are NOT
# ignored, deliberately. They are the *measurements* -- what the models scored
# and on what -- and they are what docs/model-card.md is generated from. The
# weights are reproducible from the dataset; the record of what they achieved
# on a particular held-out fold is not, and losing it would leave a model card
# nobody could check.

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# npm on Windows occasionally materialises its cache under the reserved name NUL
NUL/
