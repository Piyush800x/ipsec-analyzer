# Copy to .env and fill in. .env is git-ignored; never commit real credentials.
# The backend reads ./.env when run from the repo root and ../.env when run
# from backend/, so one file at the repo root serves both.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Two Neon URLs, and they are NOT interchangeable.
#
#   DATABASE_URL         pooled endpoint  -> the API and the app
#   DATABASE_URL_DIRECT  direct endpoint  -> Alembic migrations, and only those
#
# The pooled host has "-pooler" in it. PgBouncer runs there in transaction mode,
# which breaks asyncpg's prepared-statement cache (session.py passes
# statement_cache_size=0 to cope) and cannot hold the session-level locks
# Alembic takes. Running migrations through the pooler fails in ways that look
# like flaky network errors. Use the direct endpoint.
#
# Use ?ssl=require, NOT ?sslmode=require. Neon's copy-paste string is written
# for libpq; asyncpg does not know the libpq spelling and raises
# "connect() got an unexpected keyword argument 'sslmode'".
DATABASE_URL=postgresql+asyncpg://<user>:<password>@ep-<endpoint-id>-pooler.<region>.aws.neon.tech/<database>?ssl=require
DATABASE_URL_DIRECT=postgresql+asyncpg://<user>:<password>@ep-<endpoint-id>.<region>.aws.neon.tech/<database>?ssl=require

# Your own Neon branch. One per developer -- see docs/database-setup.md.
# Recorded here for traceability; the URLs above are what actually connect.
NEON_BRANCH=dev/<your-name>

# Offline / air-gapped / CI. Set DATABASE_URL to this and leave the Neon URLs
# unset to run entirely locally. Both backends must behave identically.
# DATABASE_URL=sqlite+aiosqlite:///./data/analyzer.db
# DATABASE_URL_DIRECT=sqlite+aiosqlite:///./data/analyzer.db

# ---------------------------------------------------------------------------
# Storage and runtime
# ---------------------------------------------------------------------------
# PCAPs live on the filesystem, never in the database.
STORAGE_PATH=./data/captures

# Assessment policy file (LLD §8.1) and trained model artefacts.
POLICY_PATH=./src/analyzer/assess/policies/baseline.yaml
MODEL_DIR=./models

# 2 GB upload cap (LLD §9).
MAX_UPLOAD_BYTES=2147483648

# Bounds concurrent analyses (LLD §9, asyncio.Semaphore).
MAX_CONCURRENT_ANALYSES=2

# ---------------------------------------------------------------------------
# Emailed reports (optional)
# ---------------------------------------------------------------------------
# Leave SMTP_HOST unset and emailing is off: the dashboard's "email the PDF
# reports" field is refused with a 503 that says so. Setting it sends report
# content (never the capture itself) off this machine, which the offline
# posture otherwise rules out -- leave it unset for air-gapped use.
#
# SMTP_SECURITY: starttls (port 587, the default), ssl (implicit TLS, 465), or
# none (cleartext; a relay on the same host or a test sink only).
# SMTP_PORT defaults to the port the security mode uses.
#
# Gmail: SMTP_HOST=smtp.gmail.com, your address as SMTP_USERNAME and SMTP_FROM,
# and an App Password (not your account password) as SMTP_PASSWORD.
# SMTP_FROM is always required -- some providers' usernames (SendGrid's
# "apikey") are not addresses any receiving server will accept mail from.
# SMTP_HOST=smtp.example.com
# SMTP_SECURITY=starttls
# SMTP_PORT=587
# SMTP_USERNAME=reports@example.com
# SMTP_PASSWORD=<app password>
# SMTP_FROM=IPsec Analyzer <reports@example.com>

# Where the dashboard is reachable, so an emailed report can link back to its
# assessment. Optional; without it the email carries no link.
# DASHBOARD_URL=http://localhost:3000
